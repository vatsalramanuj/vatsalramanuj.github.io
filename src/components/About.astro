<script>
const observer = new IntersectionObserver(
  (entries) => {

    entries.forEach(entry => {

      if (entry.isIntersecting) {

        document
          .querySelectorAll(".about-card-left")
          .forEach(el =>
            el.classList.add("show")
          );


        document
          .querySelectorAll(".about-card-right")
          .forEach((el, i) => {

            setTimeout(() => {
              el.classList.add("show");
            }, i * 150);

          });

      }

    });

  },
  {
    threshold: 0.3
  }
);


const about = document.querySelector(".about-card-left");

if (about) {
  observer.observe(about);
}

</script>

<style>

.about-card-left {
  opacity:0;
  transform:translateX(-80px);
  transition:
    opacity 0.8s ease,
    transform 0.8s ease;
}


.about-card-right {
  opacity:0;
  transform:translateX(80px);
  transition:
    opacity 0.8s ease,
    transform 0.8s ease;
}


.show {

  opacity:1;
  transform:translateX(0);

}

</style>