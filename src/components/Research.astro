---
import ReceiverAnimation from "./research/ReceiverAnimation.astro";
import BesselRingAnimation from "./research/BesselRingAnimation.astro";
import NoiseFloorAnimation from "./research/NoiseFloorAnimation.astro";

const research = [
  {
    title: "Physics-Informed Passive Radar Localization",
    slug: "physics-informed-passive-radar-localization",
    institution: "Indian Institute of Technology Madras",
    duration: "Jan 2025 – May 2025",
    supervisor: "Prof. K. Giridhar",
    supervisorLink: "https://scholar.google.com/citations?user=WAZimrsAAAAJ&hl=en",
    description:
      "Developed a deep learning framework for localising and tracking multiple airborne targets in a multistatic distributed passive radar network.",
    highlights: [
      "Physics-informed GRU–Transformer architecture",
      "Time of Flight and Doppler measurements used as measured inputs",
      "Joint estimation of 3D position and velocity",
      "Near-constant inference time even for a large number of targets",
      "14 m localisation RMSE, with 99.2% detections with full CRLB noise added in measurements.",
    ],
    technologies: [
      "Python",
      "PyTorch",
      "Signal Processing",
      "Multistatic Radar",
      "Machine Learning",
    ],
  },

  {
    title: "Light-Sheet Fluorescence Microscopy",
    slug: "light-sheet-fluorescence-microscopy",
    institution: "Centre of Light for Life, University of Adelaide",
    duration: "May 2024 – Jul 2024",
    supervisor: "Prof. Kishan Dholakia",
    supervisorLink: "https://scholar.google.com/citations?user=OlD7pJoAAAAJ&hl=en",
    description:
      "At CLL, Adelaide; I spent 2 months working on Light Sheet fluorescence microscopy for deep tissue imaging and its reconstruction. I helped develop a twin-Airy beam imaging setup and implemented iterative deconvolution algorithms to recover a 3D image of the tissue.",
    highlights: [
      "Bessel and Airy Beams for diffraction-free Light Sheet Fluorescence Microscopy for deep tissue imaging",
      "PSF deconvolution of Twin-Airy beam on real images of biological tissues taken by light sheet fluorescence microscopy methods",
    ],
    technologies: [
      "Optics",
      "Python",
      "Image Processing",
      "Lasers",
    ],
  },

  {
    title: "21-cm Radio Astronomy Receiver",
    slug: "21-cm-radio-astronomy-receiver",
    institution: "Indian Institute of Technology Madras",
    duration: "2023 – 2024",
    supervisor: "Prof. C.V. Krishnamurthy",
    supervisorLink: "https://scholar.google.com/citations?user=eDQ4-JkAAAAJ&hl=en",
    description:
      "Worked on the instrumentation as well as the data analysis for detecting the 1420MHz neutral Hydrogen line. ",
    highlights: [
      "Built and tuned the receiver chain, which included an LPDA and LNA connected via a coaxial cable to an SDR.",
      "Achieved Impedance mathcing between antenna and receiver, and captured RF astronmical data from the galactic plane",
    ],
    technologies: [
      "RF Engineering",
      "Antenna systems",
      "Spectral analysis",
      "Python",
      "Astronomy",
    ],
  },
];
---

<section id="research" class="py-32 bg-zinc-950">
  <div class="container mx-auto max-w-7xl px-6">

    <!-- Section Heading -->
    <div class="mb-20">

      <p class="uppercase tracking-[0.35em] text-sky-400 text-sm mb-4">
        Research
      </p>

      <h2 class="text-5xl md:text-6xl font-bold font-['Space_Grotesk']">
        Research Experience
      </h2>

      <p class="text-zinc-400 max-w-3xl mt-8 text-lg leading-8">
        My research focuses on intelligent sensing systems that combine
        machine learning with communication systems, RF engineering,
        optics and computational imaging.
        I enjoy building systems where physical modelling and AI work
        together to solve real engineering problems.
      </p>

    </div>

    <!-- Cards -->
    <div class="space-y-10">

      {research.map((project) => (

        <article
          class="relative overflow-hidden
                 rounded-3xl
                 border border-white/10
                 bg-white/5
                 backdrop-blur-md
                 p-8 md:p-10
                 group
                 transition-all duration-500
                 hover:border-sky-500/40
                 hover:bg-white/10
                 hover:-translate-y-1">

          {/* Animated background only for Passive Radar project */}
          {project.title === "Physics-Informed Passive Radar Localization" && (
            <>
              <div
                class="absolute inset-0 z-0 opacity-50
                       transition-opacity duration-500
                       group-hover:opacity-70">

                <ReceiverAnimation
                  hexSize={18}
                  radius={90}
                  color="#38bdf8"
                  opacity={0.04}
                />

              </div>

              {/* Readability overlay */}
              <div
                class="absolute inset-0 z-[1]
                       bg-gradient-to-br
                       from-zinc-950/40
                       via-zinc-950/20
                       to-zinc-950/50">
              </div>
            </>
          )}

          {/* Animated background only for Light-Sheet Microscopy project */}
          {project.title === "Light-Sheet Fluorescence Microscopy" && (
            <>
              <div
                class="absolute inset-0 z-0 opacity-50
                       transition-opacity duration-500
                       group-hover:opacity-70">

                <BesselRingAnimation
                  radius={140}
                  ringSpacing={16}
                  color="#67e8f9"
                  opacity={0.9}
                />

              </div>

              {/* Readability overlay */}
              <div
                class="absolute inset-0 z-[1]
                       bg-gradient-to-br
                       from-zinc-950/40
                       via-zinc-950/20
                       to-zinc-950/50">
              </div>
            </>
          )}

          {/* Animated background only for 21-cm Receiver project */}
          {project.title === "21-cm Radio Astronomy Receiver" && (
            <>
              <div
                class="absolute inset-0 z-0 opacity-50
                       transition-opacity duration-500
                       group-hover:opacity-70">

                <NoiseFloorAnimation
                  radius={130}
                  color="#4ade80"
                  opacity={0.5}
                />

              </div>

              {/* Readability overlay */}
              <div
                class="absolute inset-0 z-[1]
                       bg-gradient-to-br
                       from-zinc-950/40
                       via-zinc-950/20
                       to-zinc-950/50">
              </div>
            </>
          )}

          {/* Card Content */}
          <div class="relative z-10 flex flex-col lg:flex-row gap-10">

            {/* Left */}
            <div class="lg:w-2/3">

              <h3
                class="text-3xl font-bold
                       transition-colors duration-300
                       group-hover:text-sky-400">

                {project.title}

              </h3>

              <div
                class="mt-3 flex flex-wrap gap-3
                       text-sm text-zinc-400">

                <span>{project.institution}</span>
                <span>•</span>
                <span>{project.duration}</span>

              </div>

              {project.supervisor && (
                <p class="mt-2 text-sm text-zinc-500 italic">
                  Supervised by{" "}
                  {project.supervisorLink ? (
                    <a
                      href={project.supervisorLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="not-italic text-zinc-400 underline underline-offset-2
                             decoration-zinc-600
                             transition-colors duration-300
                             hover:text-sky-400 hover:decoration-sky-400">
                      {project.supervisor}
                    </a>
                  ) : (
                    project.supervisor
                  )}
                </p>
              )}

              <p class="mt-8 text-zinc-300 leading-8">
                {project.description}
              </p>

              <div class="mt-8">

                <h4 class="text-white font-semibold mb-4">
                  Highlights
                </h4>

                <ul class="grid md:grid-cols-2 gap-3">

                  {project.highlights.map((item) => (

                    <li class="flex items-start gap-3 text-zinc-300">

                      <span
                        class="mt-1 text-sky-400
                               transition-transform duration-300
                               group-hover:scale-125">

                        ●

                      </span>

                      <span>{item}</span>

                    </li>

                  ))}

                </ul>

              </div>

              {/* <a
                href={`/research/${project.slug}`}
                class="mt-8 inline-flex items-center gap-2
                       text-sky-400 font-semibold
                       transition-colors duration-300
                       hover:text-sky-300">

                View project details

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="w-4 h-4
                         transition-transform duration-300
                         group-hover:translate-x-1">
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L11.29 6.15a.75.75 0 111.02-1.1l5 4.5a.75.75 0 010 1.1l-5 4.5a.75.75 0 11-1.02-1.1l3.098-3.1H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"
                  />
                </svg>

              </a> */}

            </div>

            {/* Right */}
            <div class="lg:w-1/3">

              <div
                class="rounded-2xl
                       border border-white/10
                       bg-zinc-900/60
                       backdrop-blur
                       p-6">

                <h4 class="font-semibold mb-5">
                  Technologies
                </h4>

                <div class="flex flex-wrap gap-3">

                  {project.technologies.map((skill) => (

                    <span
                      class="rounded-full
                             border border-sky-500/20
                             bg-sky-500/10
                             px-4 py-2
                             text-sm
                             text-sky-300
                             transition-all duration-300
                             hover:bg-sky-500/20
                             hover:border-sky-400/40">

                      {skill}

                    </span>

                  ))}

                </div>

              </div>

            </div>

          </div>

        </article>

      ))}

    </div>

  </div>
</section>