---
const research = [
  {
    title: "Physics-Informed Passive Radar Localization",
    institution: "Indian Institute of Technology Madras",
    duration: "Jan 2025 – May 2025",
    description:
      "Developed a deep learning framework for localising and tracking multiple airborne targets in a multistatic passive radar network by combining physical signal models with modern neural architectures.",
    highlights: [
      "Physics-informed GRU–Transformer architecture",
      "Fusion of TDOA and FDOA measurements",
      "Joint estimation of 3D position and velocity",
      "Near-constant inference time",
      "≈14 m localisation RMSE"
    ],
    technologies: [
      "Python",
      "PyTorch",
      "Signal Processing",
      "Radar",
      "Machine Learning"
    ]
  },

  {
    title: "Light-Sheet Fluorescence Microscopy",
    institution: "Centre of Light for Life, University of Adelaide",
    duration: "May 2024 – Jul 2024",
    description:
      "Worked on diffraction-free optical imaging using Bessel and Airy beams for high-resolution biological microscopy, combining optics with computational image reconstruction.",
    highlights: [
      "Optical alignment",
      "Beam shaping",
      "PSF deconvolution",
      "3D image reconstruction",
      "Light-sheet microscopy"
    ],
    technologies: [
      "Optics",
      "Photonics",
      "Python",
      "Image Processing",
      "Lasers"
    ]
  },

  {
    title: "21-cm Radio Astronomy Receiver",
    institution: "Indian Institute of Technology Madras",
    duration: "2023 – 2024",
    description:
      "Designed hardware and signal-processing pipelines for observing the neutral hydrogen 21-cm spectral line, gaining experience in RF systems and astronomical instrumentation.",
    highlights: [
      "Receiver chain design",
      "RF filtering",
      "Antenna systems",
      "Spectral analysis",
      "Signal processing"
    ],
    technologies: [
      "RF Engineering",
      "Antennas",
      "MATLAB",
      "Python",
      "Astronomy"
    ]
  }
];
---

<section
  id="research"
  class="py-32 bg-zinc-950">

  <div class="container mx-auto max-w-7xl px-6">

    <div class="mb-20">

      <p class="uppercase tracking-[0.35em] text-sky-400 text-sm mb-4">
        Research
      </p>

      <h2 class="text-5xl md:text-6xl font-bold font-['Space_Grotesk']">
        Research Experience
      </h2>

      <p class="text-zinc-400 max-w-3xl mt-8 text-lg leading-8">

        My research focuses on intelligent sensing systems that combine
        machine learning with communication systems, RF engineering,
        optics and computational imaging.
        I enjoy building systems where physical modelling and AI work
        together to solve real engineering problems.

      </p>

    </div>

    <div class="space-y-10">

      {
        research.map((project) => (

          <article
            class="group rounded-3xl border border-white/10
                   bg-white/5 backdrop-blur-md
                   p-8 md:p-10
                   transition-all duration-300
                   hover:border-sky-500/40
                   hover:bg-white/10
                   hover:-translate-y-1">

            <div class="flex flex-col lg:flex-row gap-10">

              <div class="lg:w-2/3">

                <h3
                  class="text-3xl font-bold
                         group-hover:text-sky-400
                         transition">

                  {project.title}

                </h3>

                <div
                  class="mt-3 flex flex-wrap gap-3
                         text-sm text-zinc-400">

                  <span>{project.institution}</span>

                  <span>•</span>

                  <span>{project.duration}</span>

                </div>

                <p
                  class="mt-8 text-zinc-300 leading-8">

                  {project.description}

                </p>

                <div class="mt-8">

                  <h4
                    class="text-white font-semibold mb-4">

                    Highlights

                  </h4>

                  <ul
                    class="grid md:grid-cols-2 gap-3">

                    {
                      project.highlights.map(item => (

                        <li
                          class="flex items-start gap-3 text-zinc-300">

                          <span class="text-sky-400 mt-1">

                            ●

                          </span>

                          <span>{item}</span>

                        </li>

                      ))
                    }

                  </ul>

                </div>

              </div>

              <div class="lg:w-1/3">

                <div
                  class="rounded-2xl
                         bg-zinc-900/60
                         border border-white/10
                         p-6">

                  <h4
                    class="font-semibold mb-5">

                    Technologies

                  </h4>

                  <div
                    class="flex flex-wrap gap-3">

                    {
                      project.technologies.map(skill => (

                        <span
                          class="rounded-full
                                 bg-sky-500/10
                                 border border-sky-500/20
                                 px-4 py-2
                                 text-sm
                                 text-sky-300">

                          {skill}

                        </span>

                      ))
                    }

                  </div>

                </div>

              </div>

            </div>

          </article>

        ))
      }

    </div>

  </div>

</section>