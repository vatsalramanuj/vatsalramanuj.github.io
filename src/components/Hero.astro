---
import InteractiveGrid from "./InteractiveGrid.astro";
---

<section class="relative flex min-h-screen items-center justify-center overflow-hidden">

  <InteractiveGrid />

  <!-- Background Glow -->
  <div
    class="absolute left-1/2 top-1/2 h-[700px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-sky-500/20 blur-[180px]">
  </div>


  <div class="relative z-10 mx-auto max-w-5xl px-6 text-center">

    <p class="mb-6 text-sm uppercase tracking-[0.35em] text-sky-400">
      MSc @ Imperial College London
    </p>


    <h1 class="font-['Space_Grotesk'] text-6xl font-bold leading-tight md:text-8xl">
      Hi! I'm Vatsal<br />
    </h1>


    <p class="mx-auto mt-8 max-w-3xl text-xl leading-8 text-zinc-400">

      <span id="typing-text"></span>
<span class="animate-pulse text-orange-300 drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]">|</span>    </p>


    <div class="mt-12 flex flex-wrap justify-center gap-5">

      <a
        href="#research"
        class="rounded-xl bg-sky-500 px-8 py-4 font-semibold transition hover:bg-sky-400">
        View Research
      </a>


      <a
        href="/Vatsal_Ramanuj_QuantFin_Banking_resume.pdf"
        class="rounded-xl border border-zinc-700 px-8 py-4 transition hover:border-zinc-500">
        Download Resume
      </a>

    </div>

  </div>



<script>
(() => {

  const segments = [
    {
      text: "Electrical engineer working at the intersection of ",
      className: ""
    },
    {
      text: "Signal Processing",
      className: "text-white"
    },
    {
      text: ", ",
      className: ""
    },
    {
      text: "Quantitative Finance",
      className: "text-white"
    },
    {
      text: ", ",
      className: ""
    },
    {
      text: "Programming",
      className: "text-white"
    },
    {
      text: ", and ",
      className: ""
    },
    {
      text: "Electromagnetics",
      className: "text-white"
    },
    {
      text: ".",
      className: ""
    }
  ];


  const container = document.getElementById("typing-text");

  if (!container) return;


  let segmentIndex = 0;
  let charIndex = 0;


  function typeNext() {

    if (segmentIndex >= segments.length) {
      return;
    }


    const segment = segments[segmentIndex];


    let span = container.querySelector(
      `[data-segment="${segmentIndex}"]`
    );


    if (!span) {

      span = document.createElement("span");

      span.dataset.segment = segmentIndex;

      span.className = segment.className;

      container.appendChild(span);

    }


    if (charIndex < segment.text.length) {

      span.textContent += segment.text[charIndex];

      charIndex++;

      setTimeout(typeNext, 35);

    } 
    else {

      segmentIndex++;

      charIndex = 0;

      setTimeout(typeNext, 80);

    }

  }


  // Small delay after page load
  setTimeout(typeNext, 600);


})();
</script>


</section>