---
const contacts = [
  {
    title: "Email",
    value: "vatsalnr@gmail.com", 
    href: "mailto:vatsalnr@gmail.com",
    icon: "✉️"
  },
  {
    title: "GitHub",
    value: "github.com/vatsalramanuj",
    href: "https://github.com/vatsalramanuj",
    icon: "💻"
  },
  {
    title: "LinkedIn",
    value: "linkedin.com/in/vatsalramanuj",
    href: "https://linkedin.com/in/vatsalramanuj",
    icon: "🔗"
  }
];
---

<section
  id="contact"
  class="relative py-32 bg-zinc-900 overflow-hidden">

  <!-- Background Glow -->
  <div
    class="absolute left-1/2 top-1/2
           h-[500px] w-[500px]
           -translate-x-1/2 -translate-y-1/2
           rounded-full
           bg-sky-500/10
           blur-[140px]">
  </div>

  <div class="relative z-10 container mx-auto max-w-5xl px-6">

    <div class="text-center">

      <p
        class="uppercase tracking-[0.35em]
               text-sky-400
               text-sm
               mb-4">

        Contact

      </p>

      <h2
        class="font-['Space_Grotesk']
               text-5xl
               md:text-6xl
               font-bold">

        Let's Build Something Together

      </h2>

      <p
        class="mx-auto
               mt-8
               max-w-3xl
               text-lg
               leading-8
               text-zinc-400">

        I'm always excited to discuss research,
        signal processing,
        machine learning,
        markets,
        photonics,
        or interesting engineering problems.

        Whether you're looking for a collaborator,
        researcher,
        or engineer,
        I'd love to hear from you.

      </p>

    </div>

    <div
      class="mt-16
             grid
             gap-8
             md:grid-cols-3">

      {
        contacts.map((contact) => (

          <a
            href={contact.href}
            target="_blank"
            class="group
                   rounded-3xl
                   border border-white/10
                   bg-white/5
                   backdrop-blur-md
                   p-8
                   text-center
                   transition-all
                   duration-300
                   hover:-translate-y-2
                   hover:border-sky-500/40
                   hover:bg-white/10">

            <div
              class="text-5xl">

              {contact.icon}

            </div>

            <h3
              class="mt-6
                     text-2xl
                     font-bold
                     group-hover:text-sky-400
                     transition">

              {contact.title}

            </h3>

            <p
              class="mt-3
                     break-all
                     text-zinc-400">

              {contact.value}

            </p>

          </a>

        ))
      }

    </div>

    <div class="mt-20 text-center">

      <a
        href="/Vatsal_Ramanuj_QuantFin_Banking_resume.pdf"
        class="inline-flex
               items-center
               gap-3
               rounded-xl
               bg-sky-500
               px-8
               py-4
               text-lg
               font-semibold
               transition
               hover:bg-sky-400">

        📄 Download Resume

      </a>

    </div>

  </div>

</section>